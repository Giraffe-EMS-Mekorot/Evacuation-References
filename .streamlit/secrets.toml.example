# דוגמה בלבד - לא הקובץ האמיתי. שני ה-secrets האלה נדרשים:
#
#   ANTHROPIC_API_KEY  - אותו מפתח API שנמצא היום ב-.env, לחילוץ הנתונים.
#   APP_PASSWORD       - סיסמה משותפת אחת (בלי שם משתמש) שמגינה על כל
#                        האפליקציה - ראה מסך הכניסה ב-streamlit_app.py.
#
# להרצה מקומית: העתיקו קובץ זה ל-.streamlit/secrets.toml (הקובץ בשם הזה,
# בלי .example, כבר ב-.gitignore - לא ייכנס למאגר) ומלאו ערכים אמיתיים.
#
# לפריסה ב-Streamlit Community Cloud: אין צורך בקובץ הזה בכלל - מדביקים את
# אותו תוכן תחת App settings -> Secrets בדשבורד של הפלטפורמה. ראו README.md.

ANTHROPIC_API_KEY = "sk-ant-..."
APP_PASSWORD = "בחרו-כאן-סיסמה-משותפת"
